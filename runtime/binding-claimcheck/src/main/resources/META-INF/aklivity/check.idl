scope claimcheck
{
    scope stream
    {
        struct ClaimCheckBeginEx extends core::stream::Extension
        {
            string16 bucket;
            string16 object;
            string8 contentType;
        }

        struct ClaimCheckEndEx extends core::stream::Extension
        {
            int64 size;
            string8 checksum;
        }
    }

    scope event
    {
        enum ClaimCheckEventType (uint8)
        {
            CLAIM_CREATED (1)
        }

        struct ClaimCreatedEx extends core::stream::Extension
        {
            string16 bucket;
            string16 object;
            int64 size;
        }

        union ClaimCheckEventEx switch (ClaimCheckEventType)
        {
            case CLAIM_CREATED: ClaimCreatedEx created;
        }
    }
}
