scope claimcheck
{
    scope event
    {
        enum ClaimCheckEventType (uint8)
        {
            CLAIM_CREATED (1),
            CLAIM_FAILED  (2)
        }

        struct ClaimCreatedEx extends core::stream::Extension
        {
            string16 bucket;
            string16 object;
            int64 size;
        }

        struct ClaimFailedEx extends core::stream::Extension
        {
            string8 reason;
        }

        union ClaimCheckEventEx switch (ClaimCheckEventType)
        {
            case CLAIM_CREATED: ClaimCreatedEx created;
            case CLAIM_FAILED:  ClaimFailedEx failed;
        }
    }
}
